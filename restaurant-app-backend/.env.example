# Supabase Configuration
SUPABASE_URL=https://your-supabase-project-url-here.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct PostgreSQL Connection (from Supabase Settings -> Database)
DATABASE_URL=your_supabase_connection_string_here

# Better Auth
BETTER_AUTH_API_KEY=your_better_auth_infra_api_key_here
BETTER_AUTH_SECRET=generate_a_32_character_or_longer_secret_here
BETTER_AUTH_URL=https://your-backend-domain.example.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# JWT Secret for token generation
JWT_SECRET=dastarkhan_jwt_secret_key_2026

# PayPal checkout setup
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENV=sandbox

# Server
PORT=5000
NODE_ENV=development
