EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_or_publishable_key
EXPO_PUBLIC_AUTH_REDIRECT_URI=dastarkhanuzbekistan://auth/callback
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_BETTER_AUTH_URL=https://your-backend-domain.example.com

# Only needed if you keep using the Express backend for menu/orders/reservations.
# For Expo Go on a real phone, use your laptop LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
